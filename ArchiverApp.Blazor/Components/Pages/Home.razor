@page "/"
@rendermode InteractiveServer
@using ArchiverApp.Domain.Abstractions
@using ArchiverApp.Domain.Enums
@using ArchiverApp.Domain.Events
@using ArchiverApp.Blazor.Components
@inject IArchiverService ArchiverService

<div class="archiver-container">

    @* -- header -- *@
    <div class="archiver-header">
        <div>
            <h2>Симулятор архіватора</h2>
            <p>Демонстрація ООП: інкапсуляція, наслідування, поліморфізм</p>
        </div>
        @if (ArchiverService.CurrentArchive is null)
        {
            <button class="demo-btn" @onclick="LoadDemoData">
                ⚡ Завантажити демо
            </button>
        }
    </div>

    @* -- toast messages -- *@
    <ToastNotification @ref="_toast" />

    @* -- archive creation -- *@
    @if (ArchiverService.CurrentArchive is null)
    {
        <div class="card">
            <div class="card-title">📁 Створити новий архів</div>

            @if (!string.IsNullOrEmpty(_createError))
            {
                <div class="alert-error">⚠️ @_createError</div>
            }

            <div class="form-row">
                <div class="form-group">
                    <label>Назва архіву</label>
                    <input class="form-control"
                        placeholder="наприклад: мій_архів"
                        maxlength="@MaxArchiveNameLength"
                        @bind="_archiveName" />
                </div>

                <div class="form-group" style="max-width:200px">
                    <label>Алгоритм стиснення</label>
                    <select class="form-control" @bind="_selectedType">
                        @foreach (var type in Enum.GetValues<CompressionType>())
                        {
                            <option value="@type">@GetAlgorithmLabel(type)</option>
                        }
                    </select>
                </div>

                <div class="form-group" style="max-width:fit-content">
                    <label>&nbsp;</label>
                    <button class="btn btn-success" @onclick="HandleCreateArchive">
                        ✚ Створити архів
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        @* -- archive info -- *@
        <ArchiveInfo Archive="ArchiverService.CurrentArchive" />

        @* -- progress -- *@
        <ProgressPanel IsVisible="_isProcessing"
                       Title="_progressTitle"
                       Percent="_progressPercent"
                       Message="_progressMessage" />

        @* -- files table -- *@
        <FileTable Files="ArchiverService.CurrentArchive.Files"
                   IsProcessing="_isProcessing"
                   OnRemove="HandleRemoveFile" />

        @* -- add file form -- *@
        <AddFileForm IsProcessing="_isProcessing"
                     OnAdd="HandleAddFile" />

        @* -- operation buttons -- *@
        <div class="card">
            <div class="card-title">⚙️ Операції</div>

            <div style="margin-bottom:0.75rem">
                <span class="algorithm-badge">
                    🔧 Алгоритм: @GetAlgorithmLabel(ArchiverService.CurrentArchive.CompressionType)
                </span>
            </div>

            <div class="form-row">
                <button class="btn btn-primary"
                        disabled="@(_isProcessing ||
                                    ArchiverService.CurrentArchive.FileCount == 0 ||
                                    ArchiverService.CurrentArchive.Status == ArchiveStatus.Compressed)"
                        @onclick="HandleCompress">
                    🗜 Стиснути
                </button>

                <button class="btn btn-warning"
                        disabled="@(_isProcessing ||
                                    ArchiverService.CurrentArchive.Status != ArchiveStatus.Compressed)"
                        @onclick="HandleDecompress">
                    📂 Розпакувати
                </button>

                <button class="btn btn-secondary"
                        disabled="@_isProcessing"
                        @onclick="HandleClear">
                    🗑 Очистити архів
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_operationError))
            {
                <div class="alert-error" style="margin-top:1rem">
                    ⚠️ @_operationError
                </div>
            }
        </div>
    }

</div>

@code {
    // --- state ---
    private string          _archiveName     = string.Empty;
    private CompressionType _selectedType    = CompressionType.Zip;
    private string          _createError     = string.Empty;
    private string          _operationError  = string.Empty;
    private bool            _isProcessing    = false;
    private int             _progressPercent = 0;
    private string          _progressTitle   = string.Empty;
    private string          _progressMessage = string.Empty;

    private ToastNotification _toast = default!;

    // --- demo data ---
    private void LoadDemoData()
    {
        ArchiverService.CreateArchive("demo_archive", CompressionType.Zip);

        ArchiverService.AddFile("readme", ".txt",
            System.Text.Encoding.UTF8.GetBytes(
                "Це демонстраційний архів.\n" +
                "Він показує роботу алгоритмів стиснення.\n" +
                new string('=', 200)));

        ArchiverService.AddFile("data", ".csv",
            System.Text.Encoding.UTF8.GetBytes(
                string.Join("\n", Enumerable.Range(1, 30)
                    .Select(i => $"рядок_{i},значення_{i},дані_{i},результат_{i}"))));

        ArchiverService.AddFile("config", ".json",
            System.Text.Encoding.UTF8.GetBytes(
                """
                {
                  "назва": "Симулятор архіватора",
                  "версія": "1.0.0",
                  "алгоритм": "ZIP",
                  "опис": "Курсова робота з ООП",
                  "автор": "Студент",
                  "дата": "2025"
                }
                """));

        _ = _toast.ShowInfo("Демо-дані завантажено! Спробуйте стиснути архів.");
    }

    // --- handlers ---

    private const int MinArchiveNameLength = 2;
    private const int MaxArchiveNameLength = 20;

    private void HandleCreateArchive()
    {
        _createError = string.Empty;

        if (string.IsNullOrWhiteSpace(_archiveName))
        {
            _createError = "Введіть назву архіву.";
            return;
        }

        if (_archiveName.Trim().Length < MinArchiveNameLength)
        {
            _createError = $"Назва має містити щонайменше {MinArchiveNameLength} символи.";
            return;
        }

        if (_archiveName.Trim().Length > MaxArchiveNameLength)
        {
            _createError = $"Назва не може перевищувати {MaxArchiveNameLength} символів.";
            return;
        }

        ArchiverService.CreateArchive(_archiveName.Trim(), _selectedType);
        _ = _toast.ShowSuccess($"Архів «{_archiveName.Trim()}» створено!");
    }

    private void HandleAddFile((string Name, string Ext, byte[] Content) args)
    {
        _operationError = string.Empty;
        try
        {
            ArchiverService.AddFile(args.Name, args.Ext, args.Content);
            _ = _toast.ShowSuccess($"Файл «{args.Name}{args.Ext}» додано до архіву.");
        }
        catch (Exception ex)
        {
            _operationError = ex.Message;
            _ = _toast.ShowError(ex.Message);
        }
    }

    private void HandleRemoveFile(string fullName)
    {
        _operationError = string.Empty;
        ArchiverService.RemoveFile(fullName);
        _ = _toast.ShowInfo($"Файл «{fullName}» видалено.");
    }

    private async Task HandleCompress()
    {
        _operationError  = string.Empty;
        _progressTitle   = "Стиснення файлів...";
        _isProcessing    = true;

        try
        {
            await ArchiverService.CompressAsync(OnProgress);
            _ = _toast.ShowSuccess(
                $"Стиснення завершено! " +
                $"{ArchiverService.CurrentArchive!.TotalOriginalSize} Б → " +
                $"{ArchiverService.CurrentArchive.TotalProcessedSize} Б");
        }
        catch (Exception ex)
        {
            _operationError = ex.Message;
            _ = _toast.ShowError(ex.Message);
        }
        finally
        {
            _isProcessing    = false;
            _progressPercent = 0;
            _progressMessage = string.Empty;
        }
    }

    private async Task HandleDecompress()
    {
        _operationError  = string.Empty;
        _progressTitle   = "Розпакування файлів...";
        _isProcessing    = true;

        try
        {
            await ArchiverService.DecompressAsync(OnProgress);
            _ = _toast.ShowSuccess("Розпакування завершено успішно!");
        }
        catch (Exception ex)
        {
            _operationError = ex.Message;
            _ = _toast.ShowError(ex.Message);
        }
        finally
        {
            _isProcessing    = false;
            _progressPercent = 0;
            _progressMessage = string.Empty;
        }
    }

    private void HandleClear()
    {
        var name = ArchiverService.CurrentArchive?.Name ?? string.Empty;
        _operationError = string.Empty;
        _archiveName    = string.Empty;
        ArchiverService.ClearArchive();
        _ = _toast.ShowInfo($"Архів «{name}» очищено.");
    }

    // --- progress ---

    private void OnProgress(ArchiveProgressEvent e)
    {
        _progressPercent = e.ProgressPercentage;
        _progressMessage = e.Message;
        InvokeAsync(StateHasChanged);
    }

    // --- helper methods ---

    private string GetAlgorithmLabel(CompressionType type) => type switch
    {
        CompressionType.Store => "Store (без стиснення)",
        CompressionType.Zip   => "ZIP (Deflate)",
        CompressionType.Rar   => "RAR (GZip)",
        _                     => type.ToString()
    };
}